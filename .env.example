# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ---------------------------------------------------------------------------
# STRIPE
# La clave PÚBLICA (pk_...) es segura y es la única que puede ir en la app.
# NUNCA pongas aquí la clave SECRETA (sk_...): esa vive en el backend.
#   - La app usa STRIPE_PUBLISHABLE_KEY (aquí) y STRIPE_BACKEND_URL.
#   - El backend (carpeta functions/) usa STRIPE_SECRET_KEY como secreto:
#         firebase functions:secrets:set STRIPE_SECRET_KEY
# ---------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_51UOzQ5Hjl0tQSkyT07JoTomqsF8NWG7EzBWh25qht9g9gObfFnajU4yCY2C7tBc6Ipm77QfHLCFk6bj2z5RutwQw00bNMF1cFw
# Reemplaza esto por la URL real de tu Cloud Function tras desplegarla.
STRIPE_BACKEND_URL=https://us-central1-tu-proyecto.cloudfunctions.net/crearSuscripcionVip
