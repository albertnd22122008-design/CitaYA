rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // El documento del negocio usa como id el UID del dueño.
    // Se considera dueño al UID que coincide con el id del documento o con su campo userId/uid.
    function isOwner(negocioId) {
      return isAuthenticated() && (
        request.auth.uid == negocioId ||
        request.auth.uid == get(/databases/$(database)/documents/negocios/$(negocioId)).data.userId
      );
    }

    match /negocios/{negocioId} {
      // Lectura pública: los clientes necesitan buscar el local por su código único.
      allow read: if true;
      // Solo un usuario autenticado puede crear su propio negocio.
      allow create: if isAuthenticated() && (
        request.auth.uid == negocioId ||
        (('userId' in request.resource.data) && request.auth.uid == request.resource.data.userId)
      );
      // Solo el dueño puede modificar o borrar su negocio.
      allow update, delete: if isAuthenticated() && (
        (('userId' in resource.data) && request.auth.uid == resource.data.userId) ||
        (('uid' in resource.data) && request.auth.uid == resource.data.uid)
      );

      match /citas/{citaId} {
        // Los clientes (sin sesión) pueden ver y agendar citas desde su celular.
        allow read: if true;
        allow create: if true;
        // Solo el dueño del negocio puede cambiar el estado o borrar la cita.
        allow update, delete: if isOwner(negocioId);
      }

      match /barberos/{barberoId} {
        // Lectura pública para que el cliente vea el equipo disponible.
        allow read: if true;
        // Solo el dueño administra su equipo.
        allow create, update, delete: if isOwner(negocioId);
      }

      match /clientes/{clienteId} {
        // Datos CRM: privados del negocio.
        allow read, write: if isOwner(negocioId);
      }

      match /inventario/{productoId} {
        allow read: if true;
        // Solo el dueño administra su inventario.
        allow create, update, delete: if isOwner(negocioId);
      }
    }
  }
}
